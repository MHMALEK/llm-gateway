map $http_authorization $upstream_authorization {
    default $http_authorization;
    ""      "${SERVER_AUTHORIZATION}";
}

server {
    listen 80;
    server_name _;

    client_max_body_size 20m;

    location = / {
        default_type text/plain;
        return 404 "not found\n";
    }

    location /v1/ {
        proxy_pass https://openrouter.ai/api/v1/;
        proxy_ssl_server_name on;
        proxy_ssl_name openrouter.ai;
        proxy_http_version 1.1;
        proxy_set_header Host openrouter.ai;
        proxy_set_header Authorization $upstream_authorization;
        proxy_set_header Content-Type $content_type;
        proxy_set_header HTTP-Referer $http_referer;
        proxy_set_header X-Title $http_x_title;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
